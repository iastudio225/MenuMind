# RestoIA — example configuration (copy to .env and fill secrets; never commit real keys)
MONGO_URL=mongodb://localhost:27017
DB_NAME=restoia
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=*

# --- AI gateway (D1.10) ---
# AI_GATEWAY selects the provider behind the AIProvider contract:
#   gemini : historical direct Gemini provider (GEMINI_API_KEY + GEMINI_MODEL)
#   bytez  : Bytez unified gateway (BYTEZ_API_KEY + BYTEZ_PROVIDER_KEY + AI_MODEL)
AI_GATEWAY=gemini

# Direct Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bytez gateway provider (used when AI_GATEWAY=bytez)
# AI_MODEL format: provider/model, e.g. google/gemini-2.5-flash
AI_MODEL=google/gemini-2.5-flash
BYTEZ_API_KEY=
# BYTEZ_PROVIDER_KEY = underlying provider key (REQUIRED for closed-source,
# e.g. the Gemini key when AI_MODEL starts with google/)
BYTEZ_PROVIDER_KEY=
# Optional tuning (unset = provider defaults)
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=1024
# AI_TIMEOUT_S=60
