# MenuMind — example configuration (copy to .env and fill secrets; never commit real keys)
# Supabase > Project Settings > Database > Connection string (URI, preferably Session pooler)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
JWT_SECRET=change-me
MENUMIND_ENV=development
# Local startup skips data seeding by default; set true only for an explicit seed run.
MENUMIND_SEED_ON_STARTUP=false
# Used when MENUMIND_SEED_ON_STARTUP=true (set a unique, strong password).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:3001
# Development mode also permits localhost:3001 and 127.0.0.1:3001 automatically.
CORS_ORIGINS=

# Password reset email (optional; defaults to Emergent's integration endpoint).
INTEGRATION_PROXY_URL=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=MenuMind

# --- AI gateway (D1.10) ---
# AI_GATEWAY selects the provider behind the AIProvider contract:
#   gemini : historical direct Gemini provider (GEMINI_API_KEY + GEMINI_MODEL)
#   bytez  : Bytez unified gateway (BYTEZ_API_KEY + BYTEZ_PROVIDER_KEY + AI_MODEL)
AI_GATEWAY=gemini

# Direct Gemini provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bytez gateway provider (used when AI_GATEWAY=bytez)
# AI_MODEL format: provider/model, e.g. google/gemini-2.5-flash
AI_MODEL=google/gemini-2.5-flash
BYTEZ_API_KEY=
# BYTEZ_PROVIDER_KEY = underlying provider key (REQUIRED for closed-source,
# e.g. the Gemini key when AI_MODEL starts with google/)
BYTEZ_PROVIDER_KEY=
# Optional tuning (unset = provider defaults)
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=1024
# AI_TIMEOUT_S=60
